www/
app-web/

# Build outputs
*.apk
*.AppImage
*.tar.gz
*.dmg
*.exe

# Lock files (regenerated on npm install)
package-lock.json

# OS files
.DS_Store
Thumbs.db

# Screenshots & IDE packages
*.png
.trae-html-share-packages/

# Editor files
.vscode/
.idea/
*.swp
*.swo
